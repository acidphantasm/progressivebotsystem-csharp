@page "/progressivebotsystem"
@layout MainLayout
@using ProgressiveBotSystem.Models
@using ProgressiveBotSystem.Web.Components
@using SPTarkov.Server.Core.Utils
@using Version=SemanticVersioning.Version

@inject FileUtil FileUtil
@inject JsonUtil JsonUtil

<MudMainContent Style="height: 100vh">
    <MudContainer Style="padding-bottom: 96px;">

        <MudPaper Class="pa-6 ma-6" Elevation="4" Style="background-color:#101316;">
            <MudText Align="Align.Center" Typo="Typo.h4" Style="color:#f5f3f0;">APBS Configuration Manager</MudText>
            <MudText Align="Align.Center" Typo="Typo.body2" Class="mt-1" Style="color:#9ca3af;">
                @if (_currentVersion != null)
                {
                    <text>@_currentVersion</text>
                }
            </MudText>

            @if (MainLayout.UpdateAvailable)
            {
                <MudPaper Elevation="0" Class="d-flex align-center pa-3 mt-4"
                          Style="gap:0.75rem; background-color:rgba(245,158,11,0.08); border:1px solid #f59e0b; border-radius:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Color="Color.Warning"/>
                    <MudText Typo="Typo.body1" Style="color:#f5f3f0; flex:1;">
                        Version @MainLayout.LatestReleaseVersion is available — you're on @_currentVersion.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                               Href="https://sp-mod.com/mod/1594/apbs-acids-progressive-bot-system"
                               Target="_blank" Rel="nofollow noopener">
                        Get the update
                    </MudButton>
                </MudPaper>
            }
        </MudPaper>

        <MudPaper Class="pa-4 ma-6" Elevation="1" Style="background-color:#101316;">
            <MudText Typo="Typo.h6" Class="mb-3" Style="color:#f5f3f0;">Getting started</MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Icon="@Icons.Material.Filled.MenuOpen" IconColor="Color.Primary">
                    Open the Menu at the top left to start configuring APBS.
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Notifications" IconColor="Color.Primary">
                    Most changes are tracked automatically — the bottom right shows a count of anything unsaved, and you can click it to
                    review what's pending.
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Primary">
                    Made a mistake? "Reload Config" at the top right discards unsaved changes and reverts to the last save.
                </MudListItem>
            </MudList>
        </MudPaper>

        <MudPaper Class="pa-4 ma-6" Elevation="1" Style="background-color:#101316;">
            <MudText Align="Align.Center" Typo="Typo.body2" Style="color:#9ca3af;">
                Feedback or ideas for the mod? Let me know the SPT/Fika/WTT Discord or on the Forge page for APBS.
            </MudText>
            <div class="d-flex justify-center mt-3">
                <MudTooltip Delay="1000" Color="Color.Primary"
                            Text="I make better mods than I do landing pages for an application...Stop peeking at my tooltips.">
                    <MudText Typo="Typo.h6" Style="color:#f5f3f0;">
                        Remember to save your changes when you're done, and enjoy SPT with APBS!
                    </MudText>
                </MudTooltip>
            </div>
        </MudPaper>

        <MudPaper Class="pa-4 ma-6" Elevation="1" Style="background-color:#101316;">
            <MudText Typo="Typo.h5" Class="mb-4" Style="color:#f5f3f0;">What's new</MudText>

            @foreach (var release in RecentReleases)
            {
                <ReleaseNoteCard Release="release" IsLatestInstalled="@(release == RecentReleases.First())"/>
            }
        </MudPaper>

    </MudContainer>
</MudMainContent>

@code {
    private const int modRecentReleaseCount = 5;

    private List<ReleaseNote> _releaseNotes = [];
    private string? _currentVersion;

    private List<ReleaseNote> SortedReleases
    {
        get => _releaseNotes
            .OrderByDescending(r => TryParseVersion(r.Version))
            .ToList();
    }

    private List<ReleaseNote> RecentReleases
    {
        get => SortedReleases.Take(modRecentReleaseCount).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _currentVersion = new ModMetadata().Version.ToString();

        if (MainLayout.AppAllowUpdateChecks && !MainLayout.AlreadyCheckedForUpdate)
        {
            await CheckForUpdate();
            MainLayout.AlreadyCheckedForUpdate = true;
        }

        await LoadReleaseNotes();
        await base.OnInitializedAsync();
    }

    private async Task LoadReleaseNotes()
    {
        var path = Path.Combine(ModConfig._modPath, "wwwroot/files/ReleaseNotes.json");
        var text = await FileUtil.ReadFileAsync(path);
        _releaseNotes = JsonUtil.Deserialize<List<ReleaseNote>>(text) ?? [];
    }

    private static Version? TryParseVersion(string? versionString)
    {
        if (string.IsNullOrWhiteSpace(versionString)) return null;
        try
        {
            return new Version(versionString.TrimStart('v', 'V'));
        }
        catch
        {
            return null;
        }
    }

    private async Task CheckForUpdate()
    {
        try
        {
            var httpClient = new HttpClient();
            httpClient.DefaultRequestHeaders.UserAgent.TryParseAdd("acidphantasm");
            httpClient.DefaultRequestHeaders.Add("X-GitHub-Api-Version", "2022-11-28");

            var release = await httpClient.GetFromJsonAsync<ReleaseInformation>(
            "https://api.github.com/repos/acidphantasm/progressivebotsystem-csharp/releases/latest");

            if (release == null) return;

            var latestVersion = new Version(release.Version.TrimStart('v', 'V'));
            var currentVersion = new ModMetadata().Version;

            if (latestVersion.Major != currentVersion.Major) return;

            if (latestVersion > currentVersion)
            {
                MainLayout.UpdateAvailable = true;
                MainLayout.LatestReleaseVersion = release.Version;
                MainLayout.LatestReleaseNotesBody = release.Body;
                MainLayout.LatestReleaseUrl = release.DownloadUrl;
            }
        }
        catch
        {
            // ignored
        }
    }
}
