@using ProgressiveBotSystem.Models
@using ProgressiveBotSystem.Models.Enums
@using ProgressiveBotSystem.Services
@using SPTarkov.Server.Core.Models.Common
@using SPTarkov.Server.Core.Utils
@inject ISnackbar Snackbar
@inject JsonUtil JsonUtil
@inject IDialogService DialogService
@inject PresetStateService PresetState
@inject PresetCopyService PresetCopyService

@if (_loading)
{
    <MudOverlay Visible="true" DarkBackground="true">
        <div style="width:100vw; height:100vh;" class="d-flex justify-center align-center">
            <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large"/>
        </div>
    </MudOverlay>
}
else
{
    <MudPaper Elevation="4" Class="pa-6 ma-4" Style="background-color:#101316;">
        <MudTabs Rounded="true" PanelClass="pt-4">
            @foreach (var botType in _botTypes.Keys)
            {
                <MudTabPanel Text="@botType">

                    <div class="d-flex justify-center mb-4">
                        <MudPaper Elevation="0" Class="d-flex align-center pa-2"
                                  Style="gap:0.6rem; background-color:#0a0c0e; border:1px solid #1f2328; width:fit-content;">
                            <MudText Typo="Typo.body2" Style="color:#9ca3af; white-space:nowrap;">
                                Copy Tier@(Tier) @botType to
                            </MudText>
                            <MudSelect T="int" @bind-Value="_copyTargetTier[botType]" Dense="true" Margin="Margin.Dense"
                                       FullWidth="false" Style="width:110px;">
                                <MudSelectItem Value="0">All Tiers</MudSelectItem>
                                @for (var t = 1; t <= 7; t++)
                                {
                                    var tierValue = t;
                                    <MudSelectItem Value="@tierValue">Tier @tierValue</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="_copyTargetBotType[botType]" Dense="true"
                                       Margin="Margin.Dense" FullWidth="false" Style="width:200px;">
                                @foreach (var target in GetSameFactionBotTypes(botType))
                                {
                                    <MudSelectItem Value="@target">@target</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                       OnClick="@(() => ConfirmAndCopy(botType))">
                                Copy
                            </MudButton>
                        </MudPaper>
                    </div>

                    @if (_masterItemsPerCategory.TryGetValue(botType, out var categories))
                    {
                        @foreach (var category in categories.Keys)
                        {
                            var assignedCount = _botTypes[botType].Count(i => i.Category.Equals(category, StringComparison.OrdinalIgnoreCase));

                            <div class="d-flex align-center mb-1" style="gap:0.6rem;">
                                <MudText Typo="Typo.subtitle1">@category</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                    @assignedCount assigned
                                </MudChip>
                            </div>

                            <div class="d-flex mb-4 pa-1 w-100" style="gap: 1rem;">
                                <!-- Assigned -->
                                <div style="flex:1 1 0; display:flex; flex-direction:column;">
                                    <div class="d-flex align-center mb-1" style="height:32px;">
                                        <MudText Typo="Typo.caption" Style="color:#9ca3af;">Assigned</MudText>
                                    </div>
                                    <div class="rounded flex-grow-1"
                                         style="height:260px; overflow-y:auto; background-color:#0a0c0e;">
                                        @foreach (var item in _botTypes[botType].Where(i => i.Category.Equals(category, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <div class="d-flex align-center px-2 py-1 apbs-row"
                                                 style="gap:0.6rem; border-bottom:1px solid #1f2328;">
                                                <MudNumericField T="double"
                                                                 Min="0.0"
                                                                 Value="item.Weight"
                                                                 ValueChanged="@(v => OnWeightChanged(botType, category, item, v))"
                                                                 Variant="Variant.Outlined"
                                                                 HideSpinButtons="true"
                                                                 Margin="Margin.None"
                                                                 FullWidth="false"
                                                                 Style="width:68px; height:28px; font-size:0.8rem; padding:0 4px;"/>

                                                <MudText Typo="Typo.body2" Class="flex-grow-1"
                                                         Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                                    @item.DisplayName
                                                </MudText>

                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                               Color="Color.Default"
                                                               OnClick="@(() => MoveToAvailable(botType, category, item))"
                                                               Style="height:28px;"/>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Available -->
                                <div style="flex:1 1 0; display:flex; flex-direction:column;">
                                    <div class="d-flex align-center mb-1" style="height:32px; gap:0.5rem;">
                                        <MudText Typo="Typo.caption" Style="color:#9ca3af;">Available</MudText>
                                        <MudSpacer/>
                                        <MudTextField T="string"
                                                      Value="@(_searchTextPerCategory.GetValueOrDefault(category, string.Empty))"
                                                      ValueChanged="@(v => _searchTextPerCategory[category] = v)"
                                                      Placeholder="Search..."
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                                      Immediate="true"
                                                      Margin="Margin.Dense"
                                                      FullWidth="false"
                                                      Style="width:180px;"/>
                                    </div>

                                    <div class="rounded flex-grow-1"
                                         style="height:260px; overflow-y:auto; background-color:#0a0c0e;">
                                        @foreach (var item in GetAvailableItems(botType, category, _searchTextPerCategory.GetValueOrDefault(category, "")))
                                        {
                                            <div class="d-flex align-center px-2 py-1 apbs-row"
                                                 style="gap:0.6rem; border-bottom:1px solid #1f2328;">
                                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                                               Color="Color.Primary"
                                                               OnClick="@(() => MoveToUsed(botType, category, item))"
                                                               Style="height:28px;"/>
                                                <MudText Typo="Typo.body2"
                                                         Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                                    @item.DisplayName
                                                </MudText>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </MudTabPanel>
            }
        </MudTabs>

    </MudPaper>
}

@code {
    [Parameter] [EditorRequired] public AppearanceTierData AppearanceData { get; set; }
    [Parameter] [EditorRequired] public string Tier { get; set; }

    private bool _loading = true;
    private readonly Dictionary<string, string?> _searchTextPerCategory = new();
    private readonly Dictionary<string, Dictionary<string, List<PresetItemView>>> _masterItemsPerCategory = new();
    private readonly Dictionary<string, List<PresetItemView>> _originalBotTypes = new();
    private readonly Dictionary<string, List<PresetItemView>> _botTypes = new();
    private readonly Dictionary<string, string> _cachedItems = new();

    private readonly Dictionary<string, int> _copyTargetTier = new();
    private readonly Dictionary<string, string> _copyTargetBotType = new();

    private Action? _dataReloadedHandler;

    private void HandlePresetChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleSaveCompleted()
    {
        foreach (var botType in _botTypes.Keys)
        {
            _originalBotTypes[botType] = _botTypes[botType]
                .Select(i => new PresetItemView
                {
                    Id = i.Id,
                    Category = i.Category,
                    Weight = i.Weight,
                    DisplayName = i.DisplayName,
                    CurrentDropZone = i.CurrentDropZone,
                    botType = i.botType,
                    IsGenerationItem = i.IsGenerationItem
                })
                .ToList();
        }
    }

    public void Dispose()
    {
        PresetState.OnPresetChanged -= HandlePresetChanged;
        PresetState.OnPresetSaved -= HandleSaveCompleted;
        if (_dataReloadedHandler != null)
            PresetState.OnDataReloaded -= _dataReloadedHandler;
    }

    protected override async Task OnInitializedAsync()
    {
        PresetState.OnPresetChanged += HandlePresetChanged;
        PresetState.OnPresetSaved += HandleSaveCompleted;
        _dataReloadedHandler = () => InvokeAsync(LoadDataAsync);
        PresetState.OnDataReloaded += _dataReloadedHandler;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        await Task.Yield();

        _botTypes.Clear();
        _originalBotTypes.Clear();
        _masterItemsPerCategory.Clear();
        _cachedItems.Clear();

        try
        {
            foreach (var prop in typeof(AppearanceTierData).GetProperties())
            {
                var botType = prop.Name;
                var botTypeDictionary = prop.GetValue(AppearanceData);

                if (botTypeDictionary == null)
                    continue;

                if (botTypeDictionary is Dictionary<string, SPTarkov.Server.Core.Models.Eft.Common.Tables.Appearance> dict)
                {
                    AddAppearanceBotType(botType, dict);
                }

                else if (botTypeDictionary is SeasonAppearance season)
                {
                    foreach (var seasonProp in typeof(SeasonAppearance).GetProperties())
                    {
                        var botTypeSeasonal = seasonProp.Name;
                        var botTypeSeasonalDictionary = seasonProp.GetValue(season) as Dictionary<string, SPTarkov.Server.Core.Models.Eft.Common.Tables.Appearance>;

                        if (botTypeSeasonalDictionary == null) continue;

                        var botTypeName = $"{botType}-{botTypeSeasonal}";
                        AddAppearanceBotType(botTypeName, botTypeSeasonalDictionary);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void AddAppearanceBotType(string botTypeName, Dictionary<string, SPTarkov.Server.Core.Models.Eft.Common.Tables.Appearance> appearanceDict)
    {
        if (!_botTypes.ContainsKey(botTypeName))
            _botTypes[botTypeName] = [];

        if (!_masterItemsPerCategory.ContainsKey(botTypeName))
            _masterItemsPerCategory[botTypeName] = new Dictionary<string, List<PresetItemView>>();

        foreach (var appearanceKvp in appearanceDict)
        {
            var appearance = appearanceKvp.Value;

            foreach (var slotProp in typeof(SPTarkov.Server.Core.Models.Eft.Common.Tables.Appearance).GetProperties())
            {
                var slot = slotProp.Name.ToLowerInvariant();
                var slotValue = slotProp.GetValue(appearance);

                if (slotValue is IDictionary<MongoId, double> dict)
                {
                    if (!_masterItemsPerCategory[botTypeName].ContainsKey(slot))
                    {
                        var name = botTypeName.ToLowerInvariant().Contains("pmcusec") ? "pmcUsec" : "pmcBear";
                        _masterItemsPerCategory[botTypeName][slot] = GetAvailableItemsForCategory($"{name}_{slot}")
                            .Select(id => new PresetItemView
                            {
                                Id = id,
                                DisplayName = GetOrAddCachedName(id),
                                Category = slot,
                                CurrentDropZone = $"Available-{slot}",
                                botType = botTypeName,
                                Weight = 1
                            })
                            .ToList();
                    }

                    foreach (var kv in dict)
                    {
                        var itemView = new PresetItemView
                        {
                            Id = kv.Key,
                            DisplayName = GetOrAddCachedName(kv.Key),
                            Category = slot,
                            CurrentDropZone = slot,
                            botType = botTypeName,
                            Weight = kv.Value
                        };

                        _botTypes[botTypeName].Add(itemView);

                        if (_masterItemsPerCategory[botTypeName][slot].All(i => i.Id != kv.Key))
                        {
                            _masterItemsPerCategory[botTypeName][slot].Add(new PresetItemView
                            {
                                Id = kv.Key,
                                DisplayName = itemView.DisplayName,
                                Category = slot,
                                CurrentDropZone = $"Available-{slot}",
                                botType = botTypeName,
                                Weight = 1
                            });
                        }
                    }
                }
            }
        }

        _originalBotTypes[botTypeName] = _botTypes[botTypeName]
            .Select(i => new PresetItemView
            {
                Id = i.Id,
                DisplayName = i.DisplayName,
                Category = i.Category,
                Weight = i.Weight,
                botType = i.botType,
                CurrentDropZone = i.CurrentDropZone
            })
            .ToList();

        ApplyPendingOverlay(botTypeName);

        if (!_copyTargetTier.ContainsKey(botTypeName))
        {
            _copyTargetTier[botTypeName] = int.Parse(Tier);
        }
        _copyTargetBotType.TryAdd(botTypeName, botTypeName);
    }

    private void ApplyPendingOverlay(string botType)
    {
        var changes = PresetState.GetPendingItemChanges(
        Tier, botType,
        PresetState.AppearanceAddedItems, PresetState.AppearanceRemovedItems, PresetState.AppearanceWeightChanges,
        "_weight");

        foreach (var change in changes)
        {
            switch (change.Action)
            {
                case PendingItemAction.Add:
                    if (!_botTypes[botType].Any(i => i.Id == change.Id && i.Category.Equals(change.Category, StringComparison.OrdinalIgnoreCase)))
                    {
                        _botTypes[botType].Add(new PresetItemView
                        {
                            Id = change.Id,
                            DisplayName = GetOrAddCachedName(change.Id),
                            Category = change.Category,
                            CurrentDropZone = change.Category,
                            botType = botType,
                            Weight = change.Weight
                        });
                    }
                    break;

                case PendingItemAction.Remove:
                    _botTypes[botType].RemoveAll(i => i.Id == change.Id && i.Category.Equals(change.Category, StringComparison.OrdinalIgnoreCase));
                    break;

                case PendingItemAction.WeightOnly:
                    var existing = _botTypes[botType].FirstOrDefault(i => i.Id == change.Id && i.Category.Equals(change.Category, StringComparison.OrdinalIgnoreCase));
                    existing?.Weight = change.Weight;
                    break;
            }
        }
    }

    private IEnumerable<string> GetSameFactionBotTypes(string sourceBotType) =>
        _botTypes.Keys.Where(t => PresetCopyService.IsSameFaction(sourceBotType, t));

    private async Task ConfirmAndCopy(string sourceBotType)
    {
        var targetTier = _copyTargetTier[sourceBotType];
        var targetBotType = _copyTargetBotType[sourceBotType];
        var sourceTier = int.Parse(Tier);

        if (!PresetCopyService.IsSameFaction(sourceBotType, targetBotType))
        {
            Snackbar.Add("Appearance can only be copied within the same faction (PMC USEC to PMC USEC, PMC BEAR to PMC BEAR).", Severity.Warning, cfg => cfg.ShowCloseIcon = false);
            return;
        }

        if (targetTier == 0)
        {
            await CopyToAllTiers(sourceBotType, sourceTier, targetBotType);
            return;
        }

        if (targetTier == sourceTier && targetBotType == sourceBotType)
        {
            Snackbar.Add("Source and target can't be the same bot type and tier.", Severity.Warning, cfg => cfg.ShowCloseIcon = false);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
        "Copy Appearance",
        $"This replaces ALL of {targetBotType}'s appearance (Tier {targetTier}) with {sourceBotType}'s appearance (Tier {sourceTier}). This can't be undone except by discarding unsaved changes. Continue?",
        "Copy", cancelText: "Cancel");

        if (confirmed != true) return;

        var changeCount = PresetCopyService.CopyAppearanceBotType(sourceTier, sourceBotType, targetTier, targetBotType);

        if (changeCount < 0)
        {
            Snackbar.Add("Copy blocked: appearance can only be copied within the same faction.", Severity.Error, cfg => cfg.ShowCloseIcon = false);
            return;
        }

        Snackbar.Add($"Copied {sourceBotType} (Tier {sourceTier}) to {targetBotType} (Tier {targetTier}) — {changeCount} pending changes. Not yet saved.", Severity.Success, cfg => cfg.ShowCloseIcon = false);

        if (targetTier == sourceTier)
        {
            await LoadDataAsync();
        }
    }

    private async Task CopyToAllTiers(string sourceBotType, int sourceTier, string targetBotType)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
        "Copy Appearance to All Tiers",
        $"This replaces ALL of {targetBotType}'s appearance across every tier (1–7) with {sourceBotType}'s appearance from Tier {sourceTier} " +
        (targetBotType == sourceBotType ? $"(Tier {sourceTier} itself is left untouched). " : string.Empty) +
        "This can't be undone except by discarding unsaved changes. Continue?",
        "Copy", cancelText: "Cancel");

        if (confirmed != true) return;

        var changeCount = PresetCopyService.CopyAppearanceBotTypeToAllTiers(sourceTier, sourceBotType, targetBotType);

        if (changeCount < 0)
        {
            Snackbar.Add("Copy blocked: appearance can only be copied within the same faction.", Severity.Error, cfg => cfg.ShowCloseIcon = false);
            return;
        }

        Snackbar.Add($"Copied {sourceBotType} (Tier {sourceTier}) to {targetBotType} across all tiers — {changeCount} pending changes. Not yet saved.", Severity.Success, cfg => cfg.ShowCloseIcon = false);

        await LoadDataAsync();
    }

    private string GetOrAddCachedName(string itemId)
    {
        if (_cachedItems.TryGetValue(itemId, out var name) && !string.IsNullOrEmpty(name))
            return name;

        return itemId;
    }

    private IEnumerable<PresetItemView> GetAvailableItems(string botType, string category, string? searchText)
    {
        searchText ??= string.Empty;

        if (!_botTypes.ContainsKey(botType) || !_masterItemsPerCategory.ContainsKey(botType))
            return [];

        var usedIds = _botTypes[botType]
            .Where(i => i.Category.Equals(category, StringComparison.OrdinalIgnoreCase))
            .Select(i => i.Id)
            .ToHashSet();

        if (!_masterItemsPerCategory[botType].ContainsKey(category))
            return [];

        return _masterItemsPerCategory[botType][category]
            .Where(i => !usedIds.Contains(i.Id) && i.DisplayName.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }

    private void MoveToUsed(string botType, string category, PresetItemView item)
    {
        if (!_botTypes.ContainsKey(botType)) return;

        PresetItemView? originalItem = null;
        if (_originalBotTypes.TryGetValue(botType, out var originalList))
        {
            originalItem = originalList.FirstOrDefault(i => i.Id == item.Id && i.Category == category);
        }

        if (originalItem != null)
        {
            item.Weight = originalItem.Weight;
        }

        if (!_botTypes[botType].Any(i => i.Id == item.Id && i.Category == category))
        {
            _botTypes[botType].Add(item);
        }

        UpdatePendingChanges(botType, category, item);
    }

    private void MoveToAvailable(string botType, string category, PresetItemView item)
    {
        if (!_botTypes.TryGetValue(botType, out var previewItemList))
        {
            return;
        }
        previewItemList.RemoveAll(i => i.Id == item.Id && i.Category == category);
        item.Weight = 1;

        UpdatePendingChanges(botType, category, item);
    }

    private void OnWeightChanged(string botType, string category, PresetItemView item, double newValue)
    {
        item.Weight = newValue;

        UpdatePendingChanges(botType, category, item);
    }

    private void UpdatePendingChanges(string botType, string category, PresetItemView item)
    {
        var key = $"Tier{Tier}_{botType}_{category}_{item.Id}";

        if (!_originalBotTypes.TryGetValue(botType, out var originalList))
            return;

        var originalItem = originalList.FirstOrDefault(i => i.Id == item.Id && i.Category == category);
        var currentItem = _botTypes[botType].FirstOrDefault(i => i.Id == item.Id && i.Category == category);

        var added = originalItem == null && currentItem != null;
        var removed = originalItem != null && currentItem == null;

        var weightChanged =
            currentItem != null &&
            (
                originalItem != null && Math.Abs(currentItem.Weight - originalItem.Weight) > 0.001 ||
                originalItem == null && currentItem is not { Weight: 1 }
            );

        PresetState.SyncItemChange(
        key, added, removed, weightChanged, currentItem?.Weight ?? 0,
        PresetState.AppearanceAddedItems, PresetState.AppearanceRemovedItems, PresetState.AppearanceWeightChanges);
    }

    private List<string> GetAvailableItemsForCategory(string category) => category switch
    {
        "pmcUsec_body" => LoadIdsForCategory("UsecBody"),
        "pmcUsec_hands" => LoadIdsForCategory("UsecHands"),
        "pmcUsec_head" => LoadIdsForCategory("UsecHead"),
        "pmcUsec_feet" => LoadIdsForCategory("UsecFeet"),
        "pmcBear_body" => LoadIdsForCategory("BearBody"),
        "pmcBear_hands" => LoadIdsForCategory("BearHands"),
        "pmcBear_head" => LoadIdsForCategory("BearHead"),
        "pmcBear_feet" => LoadIdsForCategory("BearFeet"),
        _ => LoadIdsForCategory(category)
    };

    private List<string> LoadIdsForCategory(string category)
    {
        var folderPath = Path.Combine(ModConfig._modPath, "GeneratedVanillaMappings-DO_NOT_TOUCH");
        var path = Path.Combine(folderPath, $"{category}.json");
        if (!File.Exists(path)) return [];

        try
        {
            var dict = JsonUtil.DeserializeFromFile<Dictionary<string, string>>(path);
            if (dict == null)
            {
                return dict?.Keys.ToList() ?? [];
            }
            foreach (var kv in dict)
            {
                _cachedItems[kv.Key] = kv.Value;
            }
            return dict?.Keys.ToList() ?? [];
        }
        catch
        {
            return [];
        }
    }
}
