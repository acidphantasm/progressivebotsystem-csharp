@page "/progressivebotsystem/blacklisting"
@using Microsoft.AspNetCore.Authorization
@using ProgressiveBotSystem.Web.Components
@layout MainLayout
@attribute [Authorize(Policy = "Administrator")]

<MudMainContent>
    <MudContainer Class="mb-20">
        <MudTabs Centered="true" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6 ma-2">
            <MudTabPanel Text="Weapon Blacklists">
                <BlacklistCategoryPanel CategoryPropertyName="WeaponBlacklist" CategoryShortName="Weapon"/>
            </MudTabPanel>
            <MudTabPanel Text="Equipment Blacklists">
                <BlacklistCategoryPanel CategoryPropertyName="EquipmentBlacklist" CategoryShortName="Equipment"/>
            </MudTabPanel>
            <MudTabPanel Text="Ammo Blacklists">
                <BlacklistCategoryPanel CategoryPropertyName="AmmoBlacklist" CategoryShortName="Ammo"/>
            </MudTabPanel>
            <MudTabPanel Text="Attachment Blacklists">
                <BlacklistCategoryPanel CategoryPropertyName="AttachmentBlacklist" CategoryShortName="Attachment"/>
            </MudTabPanel>
            <MudTabPanel Text="Clothing Blacklists">
                <BlacklistCategoryPanel CategoryPropertyName="ClothingBlacklist" CategoryShortName="Clothing"/>
            </MudTabPanel>
        </MudTabs>
    </MudContainer>
</MudMainContent>
