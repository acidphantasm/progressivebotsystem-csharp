@page "/progressivebotsystem/tierdelta"
@using Microsoft.AspNetCore.Authorization
@using ProgressiveBotSystem.Models
@using ProgressiveBotSystem.Models.Enums
@using ProgressiveBotSystem.Services
@using ProgressiveBotSystem.Web.Components
@layout MainLayout
@inject PresetStateService PresetStateService
@attribute [Authorize(Policy = "Administrator")]
<MudMainContent>
    <MudContainer Class="mb-20">

        <MudExpansionPanels MultiExpansion="true">

            <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="AI Level Picking Mode" Expanded="true">
                <MudText Align="Align.Center" Class="mt-4">
                    <b>Level Picking Mode</b> determines how APBS selects the level range for bots.
                </MudText>

                <MudText Align="Align.Center" Class="mt-2">
                    <b>Delta</b> mode selects a level range relative to your current level.
                </MudText>

                <MudText Align="Align.Center" Class="mt-2">
                    <b>Weighted</b> mode rolls for a tier using the configured weights, then uses that tier's level range.
                </MudText>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                    <b>Tip:</b> You only need to change the values below if you want to customize the default level ranges,
                    variances, or weighted chances. The default values are shown below.
                </MudAlert>

                <MudDivider Class="my-4"/>

                <MudGrid>
                    <MudSelectUndoDefaultTT
                        Label="Level Picking Mode"
                        TooltipText="Delta = bots spawn within a level range above/below you. Weighted = bots roll which tier's level range to spawn from, by weighted chance."
                        Value="@LevelPickingMode"
                        ValueChanged="@(x => LevelPickingMode = x)"
                        Items="@_levelPickingModes"
                        HasPendingChanges="@(PresetStateService.PendingChanges.Contains(nameof(LevelPickingMode)))"
                        IsNonDefault="@(LevelPickingMode != "Weighted Selection")"
                        OnUndo="UndoLevelPickingMode"
                        OnDefault="DefaultLevelPickingMode"/>
                </MudGrid>
            </MudExpansionPanel>

            @if (LevelPickingMode == "Delta")
            {
                <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="Level Deltas" Expanded="true">
                    <MudGrid>
                        <MudSwitchTT
                            Label="Custom Level Deltas"
                            TooltipText="Configure your own level deltas. These are the levels that bots can spawn while YOU are in the specific tier."
                            @bind-Value="TierDeltaCustomEnabled"
                            HasPendingChanges="@(PresetStateService.PendingChanges.Contains("TierDeltaCustomEnabled"))"
                            IsNonDefault="@(TierDeltaCustomEnabled)"
                            OnUndo="UndoTierDeltaCustomEnabled"
                            OnDefault="DefaultTierDeltaCustomEnabled"/>

                        @foreach (var (tier, playerMin, playerMax) in TierDefaults.Ranges)
                        {
                            <DeltaTierRow Tier="tier" PlayerMin="playerMin" PlayerMax="playerMax"
                                          Enabled="TierDeltaCustomEnabled"
                                          Current="ModConfig.Config.CustomLevelDeltas[tier]"
                                          Original="ModConfig.OriginalConfig.CustomLevelDeltas[tier]"
                                          DefaultValue="TierDefaults.PmcDeltaDefaults[tier - 1]"
                                          PendingKeyPrefix="@($"TierDeltaCustomTier{tier}")"/>
                        }
                    </MudGrid>
                </MudExpansionPanel>

                <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="Scav Level Deltas" Expanded="true">
                    <MudGrid>
                        <MudSwitchTT
                            Label="Custom Scav Level Deltas"
                            TooltipText="Configure your own level deltas specifically for Scavs. Overrides above level deltas for Scavs ONLY."
                            @bind-Value="TierDeltaCustomScavEnabled"
                            HasPendingChanges="@(PresetStateService.PendingChanges.Contains("TierDeltaCustomScavEnabled"))"
                            IsNonDefault="@(TierDeltaCustomScavEnabled)"
                            OnUndo="UndoTierDeltaCustomScavEnabled"
                            OnDefault="DefaultTierDeltaCustomScavEnabled"/>

                        @foreach (var (tier, playerMin, playerMax) in TierDefaults.Ranges)
                        {
                            <DeltaTierRow Tier="tier" PlayerMin="playerMin" PlayerMax="playerMax"
                                          Enabled="TierDeltaCustomScavEnabled"
                                          Current="ModConfig.Config.CustomScavLevelDeltas[tier]"
                                          Original="ModConfig.OriginalConfig.CustomScavLevelDeltas[tier]"
                                          DefaultValue="TierDefaults.ScavDeltaDefaults[tier - 1]"
                                          PendingKeyPrefix="@($"TierDeltaCustomScavTier{tier}")"
                                          MinAllowedMax="-79"/>
                        }
                    </MudGrid>
                </MudExpansionPanel>
            }
            else
            {
                <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="Level Weights" Expanded="true">
                    <MudGrid>
                        <MudSwitchTT
                            Label="Custom Level Weights"
                            TooltipText="Configure your own weighted chances. Determines which tier's level range bots pull from while YOU are in the specific tier."
                            @bind-Value="TierWeightCustomEnabled"
                            HasPendingChanges="@(PresetStateService.PendingChanges.Contains("TierWeightCustomEnabled"))"
                            IsNonDefault="@(TierWeightCustomEnabled)"
                            OnUndo="UndoTierWeightCustomEnabled"
                            OnDefault="DefaultTierWeightCustomEnabled"/>
                    </MudGrid>

                    @foreach (var tier in Enumerable.Range(1, 7))
                    {
                        <MudExpansionPanel Class="mud-expansion-panels-borders ma-2 pa-3" Text="@($"Tier {tier}")">
                            <WeightTierPanel Tier="tier"
                                             Enabled="TierWeightCustomEnabled"
                                             Entries="ModConfig.Config.CustomLevelWeights[tier]"
                                             Original="ModConfig.OriginalConfig.CustomLevelWeights[tier]"
                                             DefaultWeights="TierDefaults.WeightDefaults[tier - 1]"
                                             PendingKeyPrefix="@($"TierWeightCustomTier{tier}_")"/>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanel>

                <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="Scav Level Weights" Expanded="true">
                    <MudGrid>
                        <MudSwitchTT
                            Label="Custom Scav Level Weights"
                            TooltipText="Configure your own weighted chances specifically for Scavs. Overrides above level weights for Scavs ONLY."
                            @bind-Value="TierWeightCustomScavEnabled"
                            HasPendingChanges="@(PresetStateService.PendingChanges.Contains("TierWeightCustomScavEnabled"))"
                            IsNonDefault="@(TierWeightCustomScavEnabled)"
                            OnUndo="UndoTierWeightCustomScavEnabled"
                            OnDefault="DefaultTierWeightCustomScavEnabled"/>
                    </MudGrid>

                    @foreach (var tier in Enumerable.Range(1, 7))
                    {
                        <MudExpansionPanel Class="mud-expansion-panels-borders ma-2 pa-3" Text="@($"Tier {tier}")">
                            <WeightTierPanel Tier="tier"
                                             Enabled="TierWeightCustomScavEnabled"
                                             Entries="ModConfig.Config.CustomScavLevelWeights[tier]"
                                             Original="ModConfig.OriginalConfig.CustomScavLevelWeights[tier]"
                                             DefaultWeights="TierDefaults.WeightDefaults[tier - 1]"
                                             PendingKeyPrefix="@($"TierWeightCustomScavTier{tier}_")"/>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudContainer>
</MudMainContent>

@code
{
    #region LEVEL PICKING MODE
    private readonly string[] _levelPickingModes = ["Delta", "Weighted Selection"];

    private string LevelPickingMode
    {
        get => ModConfig.Config.LevelPickingMode == BotLevelPickingMode.Weighted ? "Weighted Selection" : "Delta";
        set
        {
            var enumValue = value == "Weighted Selection" ? BotLevelPickingMode.Weighted : BotLevelPickingMode.Delta;
            var originalString = ModConfig.OriginalConfig.LevelPickingMode == BotLevelPickingMode.Weighted ? "Weighted Selection" : "Delta";
            Utils.UpdateView(value, originalString, nameof(LevelPickingMode));
            ModConfig.Config.LevelPickingMode = enumValue;
        }
    }
    private void UndoLevelPickingMode() => LevelPickingMode = ModConfig.OriginalConfig.LevelPickingMode == BotLevelPickingMode.Weighted ? "Weighted Selection" : "Delta";
    private void DefaultLevelPickingMode() => LevelPickingMode = "Delta";
    #endregion

    #region CUSTOM LEVEL DELTA ENABLE
    private bool TierDeltaCustomEnabled
    {
        get => ModConfig.Config.CustomLevelDeltas.Enable;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.CustomLevelDeltas.Enable, nameof(TierDeltaCustomEnabled));
            ModConfig.Config.CustomLevelDeltas.Enable = value;
        }
    }
    private void UndoTierDeltaCustomEnabled() => TierDeltaCustomEnabled = ModConfig.OriginalConfig.CustomLevelDeltas.Enable;
    private void DefaultTierDeltaCustomEnabled() => TierDeltaCustomEnabled = false;

    private bool TierDeltaCustomScavEnabled
    {
        get => ModConfig.Config.CustomScavLevelDeltas.Enable;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.CustomScavLevelDeltas.Enable, nameof(TierDeltaCustomScavEnabled));
            ModConfig.Config.CustomScavLevelDeltas.Enable = value;
        }
    }
    private void UndoTierDeltaCustomScavEnabled() => TierDeltaCustomScavEnabled = ModConfig.OriginalConfig.CustomScavLevelDeltas.Enable;
    private void DefaultTierDeltaCustomScavEnabled() => TierDeltaCustomScavEnabled = false;
    #endregion

    #region CUSTOM LEVEL WEIGHT ENABLE
    private bool TierWeightCustomEnabled
    {
        get => ModConfig.Config.CustomLevelWeights.Enable;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.CustomLevelWeights.Enable, nameof(TierWeightCustomEnabled));
            ModConfig.Config.CustomLevelWeights.Enable = value;
        }
    }
    private void UndoTierWeightCustomEnabled() => TierWeightCustomEnabled = ModConfig.OriginalConfig.CustomLevelWeights.Enable;
    private void DefaultTierWeightCustomEnabled() => TierWeightCustomEnabled = false;

    private bool TierWeightCustomScavEnabled
    {
        get => ModConfig.Config.CustomScavLevelWeights.Enable;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.CustomScavLevelWeights.Enable, nameof(TierWeightCustomScavEnabled));
            ModConfig.Config.CustomScavLevelWeights.Enable = value;
        }
    }
    private void UndoTierWeightCustomScavEnabled() => TierWeightCustomScavEnabled = ModConfig.OriginalConfig.CustomScavLevelWeights.Enable;
    private void DefaultTierWeightCustomScavEnabled() => TierWeightCustomScavEnabled = false;
    #endregion

    #region CASCADING PARAMETERS
    [CascadingParameter] public MainLayout? Layout { get; set; }
    #endregion
}
