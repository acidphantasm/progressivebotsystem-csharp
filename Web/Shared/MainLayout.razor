@using ProgressiveBotSystem.Helpers
@using ProgressiveBotSystem.Models
@using ProgressiveBotSystem.Models.Enums
@using ProgressiveBotSystem.Services
@using Color = MudBlazor.Color
@inherits LayoutComponentBase

@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject DataLoader Dataloader
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PresetStateService PresetStateService
@inject PresetApplicationService PresetApplicationService

<HeadContent>
    <link href="/acidphantasm-progressivebotsystem/css/app.css" rel="stylesheet"/>
    <meta name="robots" content="noindex, nofollow">
    <link
        href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@200;300;400;600;700&display=swap"
        rel="stylesheet">
</HeadContent>

<MudThemeProvider Theme="@_apbsThemeAdjustments" IsDarkMode/>
<MudPopoverProvider/>
<MudSnackbarProvider/>
<MudDialogProvider/>

<style>
    html body .mud-button-outlined-warning:hover {
        box-shadow: 0 0 0 1px rgba(251, 191, 36, 0.35), 0 4px 12px rgba(251, 191, 36, 0.12) !important;
        background-color: rgba(251, 191, 36, 0.06) !important;
        font-family: "Titillium Web", sans-serif;
    }

    html body .mud-button-outlined-warning {
        border-width: 1px !important;
    }

    html body .mud-slider-value-label {
        color: #0c0e10 !important;
        -webkit-text-fill-color: #0c0e10 !important;
        font-weight: 600 !important;
        font-size: 0.75rem !important;
    }

    html body .mud-expand-panel-text {
        font-size: 0.9rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.07em !important;
        text-transform: uppercase !important;
        color: #f59e0b !important;
        -webkit-text-fill-color: #f59e0b !important;
    }

    html body .mud-expand-panel-header .mud-icon-button {
        color: #9ca3af !important;
    }

    html body .mud-expand-panel-content {
        padding: 8px 16px 16px 16px !important;
    }

    html body .mud-expand-panel.mud-expand-panel-expanded {
        border-left: 2px solid #f59e0b !important;
        transition: border-left 0.2s ease;
    }

    html body .mud-expand-panel:not(.mud-expand-panel-expanded) {
        border-left: 2px solid transparent !important;
        transition: border-left 0.2s ease;
    }

    html body .mud-expansion-panels-borders {
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }

    html body .mud-appbar {
        border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
        box-shadow: none !important;
    }

    html body .mud-appbar-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.06) !important;
        border-bottom: none !important;
        box-shadow: none !important;
    }

    html body .mud-drawer {
        border-right: 1px solid rgba(255, 255, 255, 0.06) !important;
        box-shadow: none !important;
    }

    html body .mud-button-filled-primary:hover {
        box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.35), 0 4px 12px rgba(245, 158, 11, 0.15) !important;
    }

    html body .mud-nav-link.active {
        border-left: 2px solid #f59e0b !important;
        background-color: rgba(245, 158, 11, 0.08) !important;
    }
</style>

<div class="no-highlight">
    <MudLayout>
        <MudAppBar Dense Elevation="1">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MenuOpen" Color="Color.Primary"
                       OnClick="@(e => DrawerToggle())">Menu
            </MudButton>
            <MudSpacer/>
            <MudOverlay Visible="IsInRaid" DarkBackground="true" Absolute="true">
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RefreshPage">
                    You or someone you know is in raid. Changes cannot be made. Click to check status.
                </MudButton>
            </MudOverlay>
            <MudSpacer/>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary" OnClick="@(e => RefreshData())" Disabled="_isReloading">Reload
                    Config
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary"
                           OnClick="@(e => SaveData())" Disabled="_isSaving">Save Config
                </MudButton>
            </div>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always"
                   Variant="@DrawerVariant.Temporary" Breakpoint="Breakpoint.None">
            <MudDrawerHeader>
                <MudText Typo="Typo.h5" Class="mt-1">SETTINGS</MudText>
            </MudDrawerHeader>
            <NavMenu/>
        </MudDrawer>
        <MudMainContent Class="pt-3">
            <MudOverlay Visible="IsInRaid" DarkBackground="true" Absolute="true"/>
            <CascadingValue Value="this">
                <div class="content">
                    @Body
                </div>
            </CascadingValue>
        </MudMainContent>
        <MudAppBar Dense Elevation="1" Bottom>
            <MudCheckBox @bind-Value="AppUndoButtonToggle" Label="Show Undo Button"/>
            <MudCheckBox @bind-Value="AppDefaultButtonToggle" Label="Show Default Button"/>
            <MudCheckBox @bind-Value="AppAllowUpdateChecks" Label="Enable Update Checks"/>
            <MudSpacer/>
            @if (PresetStateService.PendingChanges.Count > 0){
                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ShowPendingChanges"
                           Style="color: #0c0e10 !important;">@PresetStateService.PendingChanges.Count.ToString() Unsaved
                    changes
                </MudButton>
            }
            @if (PresetStateService.PendingChanges.Count == 0){
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit">@PresetStateService.PendingChanges.Count.ToString() Unsaved
                    Changes
                </MudButton>
            }
        </MudAppBar>
    </MudLayout>
</div>

@code {


    readonly MudTheme _apbsThemeAdjustments = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#f59e0b",
            PrimaryDarken = "#ea6c0a",
            PrimaryLighten = "#fb923c",

            Secondary = "#2dd4bf",
            SecondaryDarken = "#1aab96",
            SecondaryLighten = "#5eead4",

            Tertiary = "#d6a85f",
            TertiaryDarken = "#d97706",
            TertiaryLighten = "#fde68a",

            Background = "#0c0e10",
            Surface = "#13171b",

            ActionDisabled = "#4b5563",
            ActionDisabledBackground = "#1f2328",

            AppbarBackground = "#0a0c0e",
            DrawerBackground = "#0a0c0e",

            TextPrimary = "#f5f3f0",
            TextSecondary = "#9ca3af",

            ActionDefault = "#6b7280",
            Divider = "#1f2328",
            TableLines = "#1f2328",
            LinesDefault = "#1f2328",

            Info = "#0e9488",
            Success = "#059669",
            Warning = "#d97706",
            Error = "#dc2626",

            DrawerIcon = "#9ca3af",
            DrawerText = "#d1d5db"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Open Sans", "Roboto", "sans-serif" }
            }
        }
    };

    private static MainLayout? _app;

    private bool _drawerOpen;
    public bool IsInRaid;

    private static bool _isSaving;
    private static bool _isReloading;
    public static bool AlreadyCheckedForUpdate = false;
    public static bool UpdateAvailable = false;

    public static bool AppUndoButtonToggle
    {
        get => ModConfig.Config.ConfigAppSettings.ShowUndo;
        set
        {
            ModConfig.Config.ConfigAppSettings.ShowUndo = value;
            Utils.UpdateView(value, ModConfig.OriginalConfig.ConfigAppSettings.ShowUndo, nameof(AppUndoButtonToggle));
        }
    }
    public static bool AppDefaultButtonToggle
    {
        get => ModConfig.Config.ConfigAppSettings.ShowDefault;
        set
        {
            ModConfig.Config.ConfigAppSettings.ShowDefault = value;
            Utils.UpdateView(value, ModConfig.OriginalConfig.ConfigAppSettings.ShowDefault, nameof(AppDefaultButtonToggle));
        }
    }
    public static bool AppAllowUpdateChecks
    {
        get => ModConfig.Config.ConfigAppSettings.AllowUpdateChecks;
        set
        {
            ModConfig.Config.ConfigAppSettings.AllowUpdateChecks = value;
            Utils.UpdateView(value, ModConfig.OriginalConfig.ConfigAppSettings.AllowUpdateChecks, nameof(AppAllowUpdateChecks));
        }
    }

    private Action? _pendingChangesHandler;

    protected override void OnInitialized()
    {
        _pendingChangesHandler = () => InvokeAsync(StateHasChanged);
        PresetStateService.OnPendingChangesUpdated += _pendingChangesHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender){
            StateHasChanged();
        }
    }

    private async void ShowPendingChangesDialog()
    {
        var changeList = PresetStateService.BuildChangeSummary(ModConfig.Config.PresetName, ModConfig.Config.UsePreset);

        var parameters = new DialogParameters<RefreshWarningDialog>
        {
            { x => x.ChangeList, changeList },
            { x => x.ButtonText, "Save Changes" },
            { x => x.Color, Color.Primary }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, BackgroundClass = "custom-blur-background" };
        var dialog = await DialogService.ShowAsync<RefreshWarningDialog>("Navigation Blocked: Unsaved Changes", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled){
            await SaveData();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_pendingChangesHandler != null){
            PresetStateService.OnPendingChangesUpdated -= _pendingChangesHandler;
        }
    }

    public MainLayout()
    {
        _app = this;
    }

    public static void EnableUnsavedChangesButton()
    {
        _app?.StateHasChanged();
    }

    public static void TriggerUiRefresh()
    {
        _app?.StateHasChanged();
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task SaveData()
    {
        try{
            _isSaving = true;
            StateHasChanged();

            var savePresetToDisk = false;
            var presetNameChange = PresetStateService.HasPendingPresetNameOrFolderChange();
            var hadPendingPresetChanges = PresetStateService.HasPendingPresetChanges();

            if (hadPendingPresetChanges){
                PresetApplicationService.ApplyPresetChanges();
                savePresetToDisk = true;
            }
            var result = await ModConfig.SaveConfig(savePresetToDisk, presetNameChange);

            StateHasChanged();
            switch (result){
                case ConfigOperationResult.Success:
                    Snackbar.Add("Config saved successfully.", Severity.Info, config => { config.ShowCloseIcon = false; });
                    if (hadPendingPresetChanges){
                        PresetStateService.RaisePresetSaved();
                        PresetStateService.RaisePresetChanged();
                    }
                    PresetStateService.ClearPendingChanges();
                    IsInRaid = false;
                    break;
                case ConfigOperationResult.InRaid:
                    Snackbar.Add("Someone is in raid. No changes made.", Severity.Error, config => { config.ShowCloseIcon = false; });
                    IsInRaid = true;
                    break;
                case ConfigOperationResult.ActiveProcess:
                    Snackbar.Add("Another process is already running.", Severity.Warning, config => { config.ShowCloseIcon = false; });
                    break;
                case ConfigOperationResult.Failure:
                default:
                    Snackbar.Add("Config failed to save.", Severity.Error, config => { config.ShowCloseIcon = false; });
                    break;
            }
        }
        catch (Exception ex){
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error, config => { config.ShowCloseIcon = false; });
        }
        finally{
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        if (PresetStateService.PendingChanges.Count > 0){
            var changeCount = PresetStateService.PendingChanges.Count switch
            {
                > 1 => $"{PresetStateService.PendingChanges.Count} unsaved changes",
                1 => "1 unsaved change",
                _ => "unsaved changes"
            };

            var parameters = new DialogParameters<RefreshWarningDialog>
            {
                { x => x.ChangeHashSet, PresetStateService.PendingChanges },
                { x => x.ButtonText, "Reload Anyway" },
                { x => x.Color, Color.Primary }
            };

            var options = new DialogOptions { MaxWidth = MaxWidth.Medium, BackgroundClass = "custom-blur-background" };

            var dialog = await DialogService.ShowAsync<RefreshWarningDialog>($"You have {changeCount}.", parameters, options);
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
                await DiscardChangesAndReload();

            return;
        }

        try{
            _isReloading = true;
            StateHasChanged();

            var result = await ModConfig.ReloadConfig();
            StateHasChanged();

            switch (result){
                case ConfigOperationResult.Success:
                    Snackbar.Add("Config reloaded successfully.", Severity.Info, cfg => cfg.ShowCloseIcon = false);
                    IsInRaid = false;
                    PresetStateService.ClearPendingChanges();
                    break;
                case ConfigOperationResult.InRaid:
                    Snackbar.Add("Someone is in raid. No changes made.", Severity.Error, cfg => cfg.ShowCloseIcon = false);
                    IsInRaid = true;
                    break;
                case ConfigOperationResult.ActiveProcess:
                    Snackbar.Add("Another process is already running.", Severity.Warning, cfg => cfg.ShowCloseIcon = false);
                    break;
                case ConfigOperationResult.Failure:
                default:
                    Snackbar.Add("Config failed to reload.", Severity.Error, cfg => cfg.ShowCloseIcon = false);
                    break;
            }
        }
        catch (Exception ex){
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error, cfg => cfg.ShowCloseIcon = false);
        }
        finally{
            _isReloading = false;
            StateHasChanged();
        }
    }

    private async Task ShowPendingChanges()
    {
        var changeCount = PresetStateService.PendingChanges.Count switch
        {
            > 1 => $"{PresetStateService.PendingChanges.Count} changes",
            1 => "1 change",
            _ => "changes"
        };
        var parameters = new DialogParameters<RefreshWarningDialog>
        {
            { x => x.ChangeHashSet, PresetStateService.PendingChanges },
            { x => x.ButtonText, "OK" },
            { x => x.showCancel, false },
            { x => x.Color, Color.Primary }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, BackgroundClass = "custom-blur-background" };

        await DialogService.ShowAsync<RefreshWarningDialog>($"You have {changeCount}.", parameters, options);
    }

    private async Task DiscardChangesAndReload()
    {
        var changeCount = PresetStateService.PendingChanges.Count switch
        {
            > 1 => $"{PresetStateService.PendingChanges.Count} changes",
            1 => "1 change",
            _ => "changes"
        };

        try{
            _isReloading = true;
            StateHasChanged();

            var result = await ModConfig.ReloadConfig();

            switch (result){
                case ConfigOperationResult.Success:
                    IsInRaid = false;
                    Snackbar.Add($"{changeCount} discarded and config reloaded.", Severity.Warning, cfg => cfg.ShowCloseIcon = false);
                    PresetStateService.ClearPendingChanges();
                    break;

                case ConfigOperationResult.InRaid:
                    Snackbar.Add("Someone is in raid. No changes made.", Severity.Error, cfg => cfg.ShowCloseIcon = false);
                    IsInRaid = true;
                    break;

                case ConfigOperationResult.ActiveProcess:
                    Snackbar.Add("Another process is already running.", Severity.Warning, cfg => cfg.ShowCloseIcon = false);
                    break;

                case ConfigOperationResult.Failure:
                default:
                    Snackbar.Add("Config failed to reload.", Severity.Error, cfg => cfg.ShowCloseIcon = false);
                    break;
            }
        }
        catch (Exception ex){
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error, cfg => cfg.ShowCloseIcon = false);
        }
        finally{
            _isReloading = false;
            StateHasChanged();
        }
    }

    private void RefreshPage()
    {
        IsInRaid = RaidInformation.IsInRaid;
        StateHasChanged();
    }
}